# Cabeceras de los ficheros estáticos.
#
# Por defecto, Workers Static Assets sirve TODO con
# `public, max-age=0, must-revalidate`, lo que obliga al navegador a revalidar
# hasta los ficheros con hash en el nombre, que por definición no cambian
# nunca. Este fichero corrige eso.
#
# Cuando varias reglas casan con la misma petición se combinan, y ante una
# misma cabecera gana la última: por eso el catch-all va primero y los casos
# concretos lo pisan.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cache-Control: public, max-age=0, must-revalidate

# Vite les pone un hash de contenido en el nombre: si el contenido cambia,
# cambia la URL. Se pueden cachear para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CONVENCIÓN: aquí el nombre del fichero hace de número de versión. Si algún
# día se sustituye inter-variable-latin.woff2 hay que RENOMBRARLO y actualizar
# el preload de index.html y el @font-face de src/index.css. Si no, quien ya
# haya visitado el sitio seguirá con la fuente antigua durante un año.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Sin hash en el nombre, pero cambian muy de tarde en tarde.
/og.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Los leen los rastreadores: conviene que vean los cambios pronto.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
