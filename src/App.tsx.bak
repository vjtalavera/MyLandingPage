import { useState } from 'react'
import type { FormEvent } from 'react'
import './App.css'

function App() {
  const [sending, setSending] = useState(false)
  const [result, setResult] = useState('')

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()

    setSending(true)
    setResult('')

    const form = event.currentTarget
    const formData = new FormData(form)

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          name: formData.get('name'),
          email: formData.get('email'),
          subject: formData.get('subject'),
          message: formData.get('message'),
        }),
      })

      const data = await response.json()

      if (response.ok && data.success) {
        setResult('Mensaje enviado correctamente.')
        form.reset()
      } else {
        setResult(data.error || 'No se ha podido enviar el mensaje.')
      }
    } catch {
      setResult('No se ha podido conectar con el servidor.')
    } finally {
      setSending(false)
    }
  }

  return (
    <div className="site">
      <header className="header">
        <div className="container header-inner">
          <a className="logo" href="#inicio">
            Java<span>Evolve</span>
          </a>

          <nav>
            <a href="#servicios">Servicios</a>
            <a href="#retos">Retos</a>
            <a href="#tecnologias">Tecnologías</a>
            <a href="#contacto">Contacto</a>
          </nav>
        </div>
      </header>

      <main>
        <section id="inicio" className="hero">
          <div className="container hero-grid">
            <div className="hero-content">
              <p className="eyebrow">JAVA · BACKEND · MODERNIZACIÓN</p>

              <h1>
                Desarrollo Java y Backend para
                <span> aplicaciones empresariales</span>
              </h1>

              <p className="hero-text">
                Desarrollo con Java y Spring Boot, APIs REST y modernización
                de aplicaciones Java existentes.
              </p>

              <div className="hero-actions">
                <a className="button primary" href="#contacto">
                  Cuéntame tu proyecto
                </a>

                <a className="text-link" href="#servicios">
                  Ver servicios →
                </a>
              </div>
            </div>

            <div className="code-card">
              <div className="code-header">
                <span />
                <span />
                <span />
              </div>

              <pre>{`JavaEvolve

Java
Spring Boot
REST APIs
Legacy Modernization

→ Analyze
→ Design
→ Develop
→ Evolve`}</pre>
            </div>
          </div>
        </section>

        <section className="problem section">
          <div className="container">
            <div className="section-heading">
              <p className="eyebrow">EVOLUCIÓN DE SOFTWARE</p>

              <h2>¿Tu aplicación Java necesita evolucionar?</h2>

              <p>
                No todos los sistemas empresariales necesitan empezar desde
                cero. A veces necesitan una nueva funcionalidad, una
                modernización progresiva o una estrategia para reducir su
                deuda técnica.
              </p>
            </div>

            <div className="cards three">
              <article className="card">
                <div className="card-number">01</div>
                <h3>Aplicación Legacy</h3>
                <p>
                  Código antiguo, deuda técnica o dificultades para mantener
                  y evolucionar la aplicación.
                </p>
              </article>

              <article className="card">
                <div className="card-number">02</div>
                <h3>Nuevos desarrollos</h3>
                <p>
                  APIs, servicios backend y nuevas funcionalidades para
                  aplicaciones empresariales.
                </p>
              </article>

              <article className="card">
                <div className="card-number">03</div>
                <h3>Modernización</h3>
                <p>
                  Evolución progresiva de tecnologías Java y arquitecturas
                  hacia sistemas más mantenibles.
                </p>
              </article>
            </div>
          </div>
        </section>

        <section id="servicios" className="section">
          <div className="container">
            <div className="section-heading">
              <p className="eyebrow">SERVICIOS</p>
              <h2>Desarrollo y evolución de aplicaciones Java</h2>
            </div>

            <div className="cards four">
              <article className="card service-card">
                <span className="service-tag">01</span>
                <h3>Desarrollo Java</h3>
                <p>
                  Desarrollo backend con Java para aplicaciones
                  empresariales y sistemas de negocio.
                </p>
                <a href="#contacto">Consultar →</a>
              </article>

              <article className="card service-card">
                <span className="service-tag">02</span>
                <h3>Spring Boot</h3>
                <p>
                  Desarrollo de servicios y APIs con Spring Boot y Spring
                  Framework.
                </p>
                <a href="#contacto">Consultar →</a>
              </article>

              <article className="card service-card">
                <span className="service-tag">03</span>
                <h3>APIs REST</h3>
                <p>
                  Diseño y desarrollo de APIs REST para integrar aplicaciones
                  y servicios.
                </p>
                <a href="#contacto">Consultar →</a>
              </article>

              <article className="card service-card featured">
                <span className="service-tag">04</span>
                <h3>Modernización Java Legacy</h3>
                <p>
                  Análisis, refactorización y migración progresiva de
                  aplicaciones Java existentes.
                </p>
                <a href="#contacto">Consultar →</a>
              </article>
            </div>
          </div>
        </section>

        <section id="retos" className="legacy-section section">
          <div className="container">
            <div className="legacy-grid">
              <div>
                <p className="eyebrow">MODERNIZACIÓN</p>

                <h2>Modernización de aplicaciones Java Legacy</h2>

                <p>
                  Las aplicaciones empresariales no siempre pueden
                  sustituirse desde cero. La evolución progresiva permite
                  analizar el sistema existente, identificar riesgos y definir
                  una estrategia adaptada al proyecto.
                </p>

                <a className="button primary" href="#contacto">
                  Analizar mi caso
                </a>
              </div>

              <div className="topics">
                <div>Java EE → Jakarta EE</div>
                <div>Java Legacy → versiones actuales</div>
                <div>JBoss / WildFly</div>
                <div>Migración hacia Spring Boot</div>
                <div>Refactorización</div>
                <div>APIs REST</div>
                <div>Arquitecturas monolíticas</div>
                <div>Reducción de deuda técnica</div>
              </div>
            </div>
          </div>
        </section>

        <section id="tecnologias" className="section technologies">
          <div className="container">
            <div className="section-heading">
              <p className="eyebrow">TECNOLOGÍAS</p>
              <h2>Stack orientado a backend empresarial</h2>
            </div>

            <div className="tech-list">
              <span>Java</span>
              <span>Spring</span>
              <span>Spring Boot</span>
              <span>Java EE</span>
              <span>Jakarta EE</span>
              <span>Hibernate</span>
              <span>REST</span>
              <span>SQL</span>
              <span>Git</span>
              <span>Microservices</span>
            </div>
          </div>
        </section>

        <section className="section challenges">
          <div className="container">
            <div className="section-heading">
              <p className="eyebrow">RETOS TÉCNICOS</p>

              <h2>Algunos problemas que podemos abordar</h2>

              <p>
                Cada aplicación tiene un contexto diferente. Si tu caso se
                parece a alguno de estos, podemos analizarlo.
              </p>
            </div>

            <div className="challenge-grid">
              <span>Migración Java EE → Jakarta EE</span>
              <span>Modernización de aplicaciones Legacy</span>
              <span>Migración a Spring Boot</span>
              <span>Evolución de APIs REST</span>
              <span>Refactorización de aplicaciones Java</span>
              <span>Reducción de deuda técnica</span>
              <span>Actualización de versiones Java</span>
              <span>Integración de sistemas empresariales</span>
            </div>

            <div className="challenge-cta">
              <p>¿Quieres saber cómo abordar un caso concreto?</p>
              <a className="button secondary" href="#contacto">
                Cuéntame el problema
              </a>
            </div>
          </div>
        </section>

        <section className="about section">
          <div className="container about-grid">
            <div>
              <p className="eyebrow">JAVAEVOLVE</p>
              <h2>Java, backend y evolución de software empresarial.</h2>
            </div>

            <div>
              <p>
                El objetivo es sencillo: entender el sistema, identificar el
                problema y construir una solución mantenible.
              </p>

              <div className="process">
                <span>01 Analizar</span>
                <span>02 Diseñar</span>
                <span>03 Desarrollar</span>
                <span>04 Evolucionar</span>
              </div>
            </div>
          </div>
        </section>

        <section id="contacto" className="contact section">
          <div className="container contact-grid">
            <div className="contact-copy">
              <p className="eyebrow">CONTACTO</p>

              <h2>Cuéntame qué necesitas construir o modernizar.</h2>

              <p>
                ¿Tienes una aplicación Java que necesita evolucionar, una
                nueva funcionalidad que desarrollar o un proyecto backend que
                quieres poner en marcha?
              </p>

              <p>
                Explícame brevemente el caso y podremos valorar el siguiente
                paso.
              </p>
            </div>

            <form className="contact-form" onSubmit={handleSubmit}>
              <label>
                Nombre
                <input name="name" type="text" required />
              </label>

              <label>
                Email
                <input name="email" type="email" required />
              </label>

              <label>
                Asunto
                <input name="subject" type="text" required />
              </label>

              <label>
                Mensaje
                <textarea
                  name="message"
                  rows={6}
                  placeholder="Cuéntame brevemente qué necesitas..."
                  required
                />
              </label>

              <button
                className="button primary"
                type="submit"
                disabled={sending}
              >
                {sending ? 'Enviando...' : 'Enviar consulta'}
              </button>

              {result && <p className="form-result">{result}</p>}
            </form>
          </div>
        </section>
      </main>

      <footer>
        <div className="container footer-inner">
          <div>
            <strong>JavaEvolve</strong>
            <span>Desarrollo Java · Backend · Modernización</span>
          </div>

          <div className="footer-links">
            <a href="#servicios">Servicios</a>
            <a href="#retos">Retos técnicos</a>
            <a href="#contacto">Contacto</a>
          </div>
        </div>
      </footer>
    </div>
  )
}

export default App